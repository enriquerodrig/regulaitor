            "type": "array",
            "title": "Segments"
          },
          "latency_ms_total": {
            "type": "integer",
            "minimum": 0.0,
            "title": "Latency Ms Total"
          },
          "cost_eur_total": {
            "type": "number",
            "minimum": 0.0,
            "title": "Cost Eur Total"
          },
          "response_time_ms": {
            "type": "integer",
            "minimum": 0.0,
            "title": "Response Time Ms"
          },
          "pii_summary": {
            "anyOf": [
              {
