            ],
            "title": "Document Reason"
          },
          "n_segments_total": {
            "type": "integer",
            "minimum": 0.0,
            "title": "N Segments Total"
          },
          "n_segments_pass": {
            "type": "integer",
            "minimum": 0.0,
            "title": "N Segments Pass"
          },
          "n_segments_block": {
            "type": "integer",
