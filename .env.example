# RegulAItor environment configuration
# Copy to .env and fill in real values.

# === Required ===
ANTHROPIC_API_KEY=
REGULAITOR_API_TOKEN=  # >=16 chars, generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"

# === API rate limits (optional, defaults shown) ===
REGULAITOR_RATE_LIMIT_ASK=30/minute
REGULAITOR_RATE_LIMIT_ANALYZE=5/minute
REGULAITOR_MAX_UPLOAD_BYTES=10485760
REGULAITOR_RATE_LIMIT_DISABLED=  # set to "1" only for tests
