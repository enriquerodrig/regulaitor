# Project: local caches + heavy artifacts
# H16 deploy: ship pre-built LanceDB index via LFS (see .gitattributes).
# Allowlist regulaitor.lance/ so it lands in the Docker build context for
# HF Spaces Docker SDK deploy. Other lance dirs (snapshots) stay excluded.
corpus/indexes/
!corpus/indexes/regulaitor.lance/
!corpus/indexes/regulaitor.lance/**
*.lance
!corpus/indexes/regulaitor.lance/chunks.lance/
!corpus/indexes/regulaitor.lance/chunks.lance/**
evals/cache/
evals/checkpoints/
evals/reports/v0.*/
evals/reports/archive/
docs/superpowers/
redteam/reports/v0.*/
notebooks/outputs/
.claude/
.superpowers/

# Tooling configs Docker doesn't need
.pre-commit-config.yaml
.github/

# Documentation (kept in repo, not in image)
docs/
